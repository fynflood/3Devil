{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3Devil",
  "version": "0.1.5",
  "identifier": "tech.ouija.threedevil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3Devil",
        "label": "main",
        "minWidth": 900,
        "minHeight": 600,
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "fyn",
    "category": "Utility",
    "shortDescription": "Track large multi-part 3D print builds",
    "longDescription": "Manage 3D printing projects with many parts: track what's printed, preview STL/3MF/OBJ files, send parts to Bambu Studio or PrusaSlicer, follow Bambu Lab printers live, and import from your DriveThruRPG library.",
    "homepage": "https://github.com/fynflood/3Devil",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2NEE3MkY1MUFCMzI4REQKUldUZEtMTWE5WEpLQmhoblBtOXJQY1hodGY5ZlhCbFJBTUJ4S3doS3JoWHVuT1NzNEhmVVpJaHcK",
      "endpoints": [
        "https://github.com/fynflood/3Devil/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
